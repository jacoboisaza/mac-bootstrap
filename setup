#!/bin/bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
export DRY_RUN=0
[[ "${1:-}" == "--dry-run" ]] && export DRY_RUN=1
source "$ROOT_DIR/scripts/lib.sh"
source "$ROOT_DIR/config/versions.env"

[[ "$(uname -s)" == "Darwin" ]] || { echo "macOS is required." >&2; exit 1; }
[[ "$(uname -m)" == "arm64" ]] || { echo "Apple Silicon arm64 is required." >&2; exit 1; }

if [[ "$DRY_RUN" != "1" ]]; then
  cat <<'PLAN'
mac-bootstrap will:
  1. Install Homebrew if it is missing
  2. Install declared CLI tools and applications
  3. Install pinned Python and Node.js runtimes
  4. Back up and link terminal, shell, and editor settings
  5. Apply conservative macOS developer preferences

It will not delete applications, install Rosetta, or automate credentials.
PLAN
  read -r -p "Continue? [y/N] " answer
  [[ "$answer" =~ ^[Yy]$ ]] || exit 0
fi

log "Xcode Command Line Tools"
if ! xcode-select -p >/dev/null 2>&1; then
  if [[ "$DRY_RUN" == "1" ]]; then echo "+ xcode-select --install"; exit 0; fi
  xcode-select --install
  echo "Complete the installer, then run ./setup again."
  exit 0
fi

log "Homebrew"
if ! command -v brew >/dev/null 2>&1; then
  if [[ "$DRY_RUN" == "1" ]]; then
    echo "+ install Homebrew using its official installer"
  else
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  fi
fi
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ "$DRY_RUN" != "1" ]]; then
  echo "Homebrew installation did not produce /opt/homebrew/bin/brew." >&2
  exit 1
fi

log "Homebrew bundle"
if [[ "$DRY_RUN" == "1" ]]; then
  echo "+ brew bundle install --file=$ROOT_DIR/Brewfile --no-upgrade"
else
  brew bundle check --file="$ROOT_DIR/Brewfile" || brew bundle install --file="$ROOT_DIR/Brewfile" --no-upgrade
fi

log "Oh My Zsh"
if [[ ! -d "$HOME/.oh-my-zsh" ]]; then
  if [[ "$DRY_RUN" == "1" ]]; then
    echo "+ unattended Oh My Zsh installation (RUNZSH=no, CHSH=no)"
  else
    RUNZSH=no CHSH=no KEEP_ZSHRC=yes sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
  fi
fi

log "Pinned runtimes"
run volta install "node@$NODE_VERSION"
run volta install "pnpm@$PNPM_VERSION"
run volta install "@google/gemini-cli@$GEMINI_CLI_VERSION"
for version in $PYTHON_VERSIONS; do run uv python install "$version"; done
run uv python pin --global "$GLOBAL_PYTHON_VERSION"

log "Dotfiles"
backup="$HOME/.mac-bootstrap-backups/$(date +%Y%m%d-%H%M%S)"
backup_and_link "$ROOT_DIR/dotfiles/zshrc" "$HOME/.zshrc" "$backup"
backup_and_link "$ROOT_DIR/dotfiles/starship.toml" "$HOME/.config/starship.toml" "$backup"
backup_and_link "$ROOT_DIR/dotfiles/ghostty-config" "$HOME/Library/Application Support/com.mitchellh.ghostty/config" "$backup"
backup_and_link "$ROOT_DIR/config/vscode-settings.json" "$HOME/Library/Application Support/Code/User/settings.json" "$backup"

log "macOS defaults"
if [[ "$DRY_RUN" == "1" ]]; then echo "+ scripts/macos-defaults.sh"; else "$ROOT_DIR/scripts/macos-defaults.sh"; fi

log "Complete"
echo "Run ./doctor, then complete interactive sign-ins."
