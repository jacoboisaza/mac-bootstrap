# Required command-line foundation
brew "bash"
brew "bat"
brew "eza"
brew "fd"
brew "gh"
brew "gnu-sed"
brew "openssl@4"
brew "redis"
brew "ripgrep"
brew "shellcheck"
brew "shfmt"
brew "starship"
brew "tree"
brew "uv"
brew "volta"
brew "watch"
brew "wget"
brew "yq"

# Repository checks run by git hooks and test suites
brew "actionlint"
brew "gitleaks"

# Database clients only; no services are started.
brew "libpq", link: false

# Kubernetes tooling; kubectl comes with Docker Desktop.
brew "helm"
brew "kind"

# Container image registries
brew "skopeo"
