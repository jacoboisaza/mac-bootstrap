#!/bin/bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
else
  echo "Homebrew is unavailable; run ./setup first." >&2
  exit 1
fi

timestamp="$(date +%Y%m%d-%H%M%S)"
directory="${1:-$ROOT_DIR/snapshots/$timestamp}"
mkdir -p "$directory"

brew bundle dump --file="$directory/Brewfile" --force --describe
{
  echo "captured_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  echo "macos=$(sw_vers -productVersion)"
  echo "architecture=$(uname -m)"
  echo "homebrew=$(brew --version | head -n 1)"
  command -v node >/dev/null 2>&1 && echo "node=$(node --version)"
  command -v pnpm >/dev/null 2>&1 && echo "pnpm=$(pnpm --version)"
  command -v uv >/dev/null 2>&1 && echo "uv=$(uv --version)"
  [[ -d "$HOME/.oh-my-zsh/.git" ]] && echo "oh_my_zsh=$(git -C "$HOME/.oh-my-zsh" rev-parse HEAD)"
} > "$directory/versions.txt"

echo "Snapshot written to $directory"
