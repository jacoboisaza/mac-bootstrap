#!/bin/bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
echo "This intentionally upgrades declared Homebrew packages and applications."
read -r -p "Continue? [y/N] " answer
[[ "$answer" =~ ^[Yy]$ ]] || exit 0
brew update
brew bundle install --file="$ROOT_DIR/Brewfile"
brew cleanup
"$ROOT_DIR/doctor"
